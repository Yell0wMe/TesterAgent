# 环境变量配置

# LLM 配置
ZHIPU_API_KEY=your-zhipu-api-key
DOC2SPEC_LLM_PROVIDER=zhipu
DOC2SPEC_LLM_MODEL=glm-4
DOC2SPEC_TEMPERATURE=0.1
DOC2SPEC_MAX_TOKENS=4096

# 编译配置
DOC2SPEC_CHUNK_SIZE=5000
DOC2SPEC_MAX_RETRIES=2
DOC2SPEC_USE_LLM=true
DOC2SPEC_AUTO_FIX=true

# 输出配置
DOC2SPEC_OUTPUT_DIR=out
DOC2SPEC_LOG_LEVEL=INFO
